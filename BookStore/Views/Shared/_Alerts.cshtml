@using BookStore.Presentation.Common

@if (TempData[TempDataKeys.Success] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData[TempDataKeys.Success]

        <button type="button"
                class="close"
                data-dismiss="alert"
                aria-label="Close">

            <span aria-hidden="true">&times;</span>

        </button>
    </div>
}

