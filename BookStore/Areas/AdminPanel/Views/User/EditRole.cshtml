@model BookStore.Application.DTOs.AdminSide.Users.EditUserRoleDTO

<div class="card">

    <div class="card-header">
        <h3 class="card-title">تغییر نقش کاربر</h3>
    </div>

    <form asp-action="EditRole" method="post">

        @Html.AntiForgeryToken()

        <input asp-for="UserId" type="hidden" />

        <div class="card-body">

            <div class="form-group">
                <label>نام</label>
                <input asp-for="FullName" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label>ایمیل</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

             <div class="form-group">
                <label>نقش</label>

                <select asp-for="SelectedRole" class="form-control">

                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role" selected="@(role == Model.SelectedRole)">
                            @role
                        </option>
                    }

                </select>

            </div>

        </div>

        <div class="card-footer">

            <button class="btn btn-success">
                ذخیره تغییرات
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                بازگشت
            </a>

        </div>

    </form>

</div>