@model List<BookStore.Domain.Entities.Book>


<div class="content-wrapper" style="min-height: 265.6px;">
    <!-- Content Header (Page header) -->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">لیست کتاب ها</h1>
                </div><!-- /.col -->
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-left">
                        <li class="breadcrumb-item"><a href="/AdminPanel">داشبورد ادمین</a></li>
                    </ol>
                </div><!-- /.col -->
            </div><!-- /.row -->
        </div><!-- /.container-fluid -->
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">

                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">جدول کتاب ها</h3>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body p-0">
                            <table class="table table-striped">
                                <tbody>
                                    <tr>
                                        <th style="width: 10px">ردیف</th>
                                        <th>نام کتاب</th>
                                        <th>قیمت کتاب </th>
                                        <th>موجودی </th>
                                        <th>دسته </th>
                                        <th>توضیحات</th>
                                    </tr>

                                    @foreach (var book in Model)
                                    {
                                        <tr>
                                            <td>@book.Id</td>
                                            <td>@book.BookTitle</td>
                                            <td>
                                                @book.BookPrice
                                            </td>
                                            <td>
                                                @book.BookInventory
                                            </td>
                                            <td>@book.Category.CategoryTitle</td>
                                            <td>@book.BookDescription</td>
                                            <td>
                                                <a class="badge badge-primary" style="cursor:pointer;"
                                                   asp-action="EditABook"
                                                   asp-area="AdminPanel"
                                                   asp-controller="Book"
                                                   asp-route-bookId="@book.Id">
                                                    ویرایش
                                               </a>

                                                <a class="badge badge-danger" style="cursor:pointer;"
                                                   asp-action="DeleteABook"
                                                   asp-area="AdminPanel"
                                                   asp-controller="Book"
                                                   asp-route-bookId="@book.Id">حذف</a>
                                            </td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                        <!-- /.card-body -->
                    </div>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>
</div>