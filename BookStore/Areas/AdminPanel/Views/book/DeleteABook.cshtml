@model BookStore.Domain.Entities.Book


    <!-- Content Header (Page header) -->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">حذف کتاب</h1>
                </div><!-- /.col -->
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-left">
                        <li class="breadcrumb-item"><a href="/AdminPanel">داشبورد ادمین</a></li>
                    </ol>
                </div><!-- /.col -->
            </div><!-- /.row -->
        </div><!-- /.container-fluid -->
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-danger">
                        <div class="card-header">
                            <h3 class="card-title">حذف کتاب</h3>
                        </div>
                        <!-- /.card-header -->
                        <!-- form start -->
                        <form asp-action="DeleteABook" asp-area="AdminPanel" asp-controller="Book" method="post">
                            <div class="card-body">
                                <div class="form-group">
                                    @* <label for="exampleInputEmail1">Id</label> *@
                                    <input type="hidden" readonly class="form-control" id="exampleInputEmail1" asp-for="Id">
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1">عنوان</label>
                                    <input type="text" class="form-control" id="exampleInputEmail1"  asp-for="BookTitle" readonly>
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1"></label>
                                    <input type="text" class="form-control" id="exampleInputEmail1"  asp-for="BookPrice"  readonly>
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1">موجودی</label>
                                    <input type="text" class="form-control" id="exampleInputEmail1" asp-for="BookInventory" readonly>
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1">توضیحات</label>
                                    <input type="text" class="form-control" id="exampleInputEmail1" asp-for="BookDescription" readonly>
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1">دسته</label>
                                    <input type="text" class="form-control" id="exampleInputEmail1" asp-for="CategoryId" readonly>
                                </div>
                            </div>
                            <!-- /.card-body -->

                            <div class="card-footer">
                                <button type="submit" class="btn btn-danger">حذف</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>