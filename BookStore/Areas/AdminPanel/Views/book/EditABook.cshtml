@model BookStore.Application.DTOs.AdminSide.Book.EditBookDTO

<div class="content-wrapper" style="min-height: 265.6px;">
    <!-- Content Header (Page header) -->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">ویرایش مشخصات کتاب</h1>
                </div><!-- /.col -->
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-left">
                        <li class="breadcrumb-item"><a href="/AdminPanel">داشبورد ادمین</a></li>
                    </ol>
                </div><!-- /.col -->
            </div><!-- /.row -->
        </div><!-- /.container-fluid -->
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">ویرایش مشخصات کتاب</h3>
                        </div>
                        <!-- /.card-header -->
                        <!-- form start -->
                        <form asp-action="EditABook" asp-area="AdminPanel" asp-controller="Book" enctype="multipart/form-data" method="post">
                            <div class="card-body">
                                <div class="form-group">
                                    <label for="exampleInputEmail1">Id</label>
                                    <input type="text" readonly class="form-control" id="exampleInputEmail1" asp-for="Id" >
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1">عنوان</label>
                                    <input type="text" class="form-control" id="exampleInputEmail1" asp-for="BookTitle" placeholder="عنوان کتاب را وارد کنید">
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1">قیمت</label>
                                    <input type="text" class="form-control" id="exampleInputEmail1" asp-for="BookPrice" placeholder="قیمت را وارد کنید">
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1">موجودی</label>
                                    <input type="text" class="form-control" id="exampleInputEmail1" asp-for="BookInventory" placeholder="موجودی را وارد کنید">
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1">توضیحات</label>
                                    <input type="text" class="form-control" id="exampleInputEmail1" asp-for="BookDescription" placeholder="توضیحات را وارد کنید">
                                </div>
                                <div>
                                    <label for="exampleInputEmail1">ویرایش عکس</label>
                                    <input asp-for="ImageFile" type="file" class="form-control" id="exampleInputEmail1" />
                                </div>
                                <div class="form-group">
                                    <label>دسته بندی</label>
                                    <select asp-for="CategoryId" class="form-control">
                                        @foreach (var item in Model.Categories)
                                        {
                                            <option value="@item.Id">
                                                @item.CategoryTitle
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <!-- /.card-body -->

                            <div class="card-footer">
                                <button type="submit" class="btn btn-primary">ارسال</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

</div>