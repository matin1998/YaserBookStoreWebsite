    @model BookStore.Application.DTOs.Account.EditProfileDTO

@{
    ViewData["Title"] = "حساب کاربری";
}

<main>

    <partial name="_CustomerHeader" />

    <div class="page-content">
        <div class="dashboard">
            <div class="container">

                <div class="row">

                    <partial name="_CustomerSidebar" />

                    <div class="col-md-8 col-lg-9">

                        <div class="card card-dashboard">

                            <div class="card-body">

                                <h3 class="card-title mb-4">
                                    اطلاعات حساب کاربری
                                </h3>

                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <div class="alert alert-success">
                                        @TempData["SuccessMessage"]
                                    </div>
                                }

                                <form asp-action="Index" method="post">

                                    @Html.AntiForgeryToken()

                                    <div asp-validation-summary="ModelOnly"
                                         class="text-danger mb-3"></div>

                                    <div class="row">

                                        <div class="col-md-6">

                                            <label asp-for="FullName"></label>

                                            <input asp-for="FullName"
                                                   class="form-control" />

                                            <span asp-validation-for="FullName"
                                                  class="text-danger"></span>

                                        </div>

                                        <div class="col-md-6">

                                            <label asp-for="PhoneNumber"></label>

                                            <input asp-for="PhoneNumber"
                                                   class="form-control" />

                                            <span asp-validation-for="PhoneNumber"
                                                  class="text-danger"></span>

                                        </div>

                                    </div>

                                    <div class="mt-3">

                                        <label asp-for="Email"></label>

                                        <input asp-for="Email"
                                               class="form-control" />

                                        <span asp-validation-for="Email"
                                              class="text-danger"></span>

                                    </div>

                                    <div class="mt-4 d-flex">

                                        <button type="submit"
                                                class="btn btn-primary">

                                            ذخیره تغییرات

                                        </button>

                                    </div>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>

</main>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}